; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Nucleon Squad 3D"
run/main_scene="res://scenes/menu.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[autoload]

Params="*res://scripts/core/params.gd"
Session="*res://scripts/core/session.gd"
SaveGame="*res://scripts/core/save_game.gd"
SceneTransition="*res://scripts/ui/scene_transition.gd"
AdService="*res://scripts/core/ad_service.gd"
Audio="*res://scripts/core/audio.gd"
Haptics="*res://scripts/core/haptics.gd"
Tutorial="*res://scripts/tutorial/tutorial.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[editor]

export/convert_text_resources_to_binary=false

[input_devices]

pointing/emulate_touch_from_mouse=true

[internationalization]

locale/translations=PackedStringArray("res://data/i18n/strings.en.translation", "res://data/i18n/strings.pt_BR.translation", "res://data/i18n/strings.es.translation")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
